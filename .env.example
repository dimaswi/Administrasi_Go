# ============================================================
# Environment Variables - Copy file ini menjadi .env
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=administrasi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ---- Backend (Go/Gin) ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=administrasi
DB_SSLMODE=disable

JWT_SECRET=ganti_dengan_secret_yang_kuat_minimal_32_karakter
PORT=8080
# URL frontend publik (contoh: http://103.xxx.xxx.xxx atau https://klinikmuhammadiyah.com)
# Digunakan untuk QR check-in rapat dan print PDF surat keluar
FRONTEND_URL=http://localhost

# ---- Frontend (Vite) ----
# Di VPS (Docker Compose), Nginx secara otomatis mem-proxy /api/ dan /uploads/ ke backend.
# Variabel VITE_API_URL ini hanya dibutuhkan jika frontend di-host terpisah atau saat dev lokal.
VITE_API_URL=

# ---- Mobile App (React Native / Expo) ----
# Untuk mobile, buat file mobile/.env dengan isi:
# EXPO_PUBLIC_API_URL=http://IP_VPS:8080
# Atau ubah langsung DEFAULT_API_URL di mobile/src/config/api.ts
