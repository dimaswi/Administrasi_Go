# ============================================================
# Environment Variables - Copy file ini menjadi .env
# cp .env.example .env  (Linux/Mac)
# copy .env.example .env  (Windows)
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=administrasi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# ---- Backend (Go/Gin) ----
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=administrasi
DB_SSLMODE=disable

JWT_SECRET=ganti_dengan_secret_yang_kuat_minimal_32_karakter
PORT=8080

# URL Domain Publik (Wajib diisi domain Zero Trust Anda, contoh: https://administrasi.namaklinik.com)
# Digunakan backend untuk mencetak link QR Code presensi rapat & scan verifikasi surat keluar
# agar saat discan menggunakan kamera HP/pihak luar, link selalu mengarah ke domain publik yang valid.
FRONTEND_URL=https://administrasi.namaklinik.com

# ---- Frontend Web (Vite + Nginx) ----
# ⚠️ PENTING: BIARKAN KOSONG (VITE_API_URL=)
# Mengapa harus kosong?
# Agar frontend React memanggil API menggunakan URL relatif (/api).
# Dengan cara ini, website BISA DIAKSES SEKALIGUS lewat:
#   1. IP Lokal klinik:  http://192.168.x.x:3233  (Nginx otomatis proxy ke backend)
#   2. Domain Tunnel:    https://administrasi.namaklinik.com (Nginx otomatis proxy ke backend)
# Keduanya otomatis berjalan lancar tanpa error CORS dan tanpa perlu build ulang!
VITE_API_URL=

# ---- Mobile App (React Native / Expo) ----
# Aplikasi Mobile mengakses server melalui Domain Zero Trust.
# Pada folder mobile, buat file mobile/.env dengan isi:
# EXPO_PUBLIC_API_URL=https://administrasi.namaklinik.com
# (Atau ubah variabel DEFAULT_API_URL di mobile/src/config/api.ts)

# ---- Port Mapping Host VPS (Bebas Konflik) ----
# Port host di VPS yang diarahkan ke container (menghindari port yang sudah terpakai di VPS)
# Cloudflare Zero Trust Tunnel cukup diarahkan ke FRONTEND_PORT (3233)
FRONTEND_PORT=3233
BACKEND_PORT=8898
POSTGRES_PORT=5434
FACE_SERVICE_PORT=5005


