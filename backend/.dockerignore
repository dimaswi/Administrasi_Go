.env
.env.*
!.env.example

# Air hot reload
.air.toml

# Uploads (persisted di volume Docker)
uploads/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore
.gitattributes

# Docker files sendiri
Dockerfile*
