# ============================================================
# .gitignore — Root Project
# ============================================================

# ── Environment ──────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Database Dump (jangan commit ke repo!) ───────────────────
dump-*.sql
docker/postgres/dump.sql
docker/postgres/*.dump

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Node.js ──────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Frontend build ───────────────────────────────────────────
frontend/dist/
frontend/.vite/

# ── Go ───────────────────────────────────────────────────────
backend/*.exe
backend/server
backend/tmp/
backend/build_test.exe
backend/backend.exe

# ── Uploads ──────────────────────────────────────────────────
backend/uploads/

# ── Scratch ──────────────────────────────────────────────────
scratch/
